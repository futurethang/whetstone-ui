# Copy to .env.local for local development. Never commit real values.
# Where each value comes from: README.md "Environment variables".

# Data API (server only; the browser never calls it)
WHETSTONE_API_URL=https://<data-app>.vercel.app/api
WHETSTONE_API_TOKEN=

# Sign-in (GitHub OAuth app; callback https://<web-app>/api/auth/callback/github)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
OWNER_GITHUB_ID=

# Cache refresh webhook (POST /api/revalidate)
REVALIDATE_SECRET=
