{
  "name": "whetstone-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "check:client": "node scripts/check-use-client.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check": "pnpm typecheck && pnpm lint && pnpm check:client && pnpm test"
  },
  "dependencies": {
    "arctic": "3.7.0",
    "jose": "6.2.18",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
